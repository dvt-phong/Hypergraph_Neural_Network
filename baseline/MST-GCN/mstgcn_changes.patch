+# Dropout probability and label of every enrollment of one DataLoader (in loader order).
+def predict(model, dataloader, device):
+    model.eval()
+    probs, labels = [], []
+    with torch.no_grad():
+        for batch in dataloader:
+            g1, g2, g3, label = [b.to(device) for b in batch]
+            if isinstance(model, nn.DataParallel):
+                preds = model.module(g1, g2, g3, False)
+            else:
+                preds = model(g1, g2, g3, False)
+            probs.extend(preds.cpu().tolist())
+            labels.extend((label[:, 3] if label.dim() > 1 else label).cpu().tolist())
+    return np.array(probs), np.array(labels)
+
