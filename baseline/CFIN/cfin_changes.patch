+# X59, truth, username and course_id of train / validation / test of one seed (index = enroll_id).
+def load_data(x_dir, seed, smoke_rows=0):
+    data = np.load(os.path.join(x_dir, 'x59_s%d.npz' % seed))
+    frames = []
+    for split in SPLITS:
+        rows = data['split'] == split
+        df = pd.DataFrame(data['X'][rows], index=data['enroll_id'][rows], columns=act_feat_basic)
+        df['truth'] = data['label'][rows]
+        df['username'] = data['user_id'][rows]
+        df['course_id'] = data['course_id'][rows]
+        if smoke_rows > 0:
+            df = df.iloc[:smoke_rows]
+        frames.append(df)
+    return frames
+
+
+# AUC, precision, recall and F1 of the dropout class (label 1) at THRESHOLD, as baseline/ML.
+def metrics(labels, probabilities):
+    predicted = probabilities >= THRESHOLD                              # ŷ = 1[p ≥ 0.5]
+    # P = TP/(TP + FP), R = TP/(TP + FN), F1 = 2·P·R/(P + R)
+    precision, recall, f1, _ = precision_recall_fscore_support(labels, predicted, labels=[1], zero_division=0)
+    return {
+        "auc": float(roc_auc_score(labels, probabilities)),             # AUC = P(p_dropout > p_non-dropout)
+        "precision": float(precision[0]),
+        "recall": float(recall[0]),
+        "f1": float(f1[0]),
+    }
+
+
+# Write split, enroll_id, label, prob of one split to a CSV file.
+def write_predictions(path, split, enroll_ids, labels, probabilities):
+    with open(path, 'w', newline='', encoding='utf-8') as output:
+        writer = csv.writer(output)
+        writer.writerow(('split', 'enroll_id', 'label', 'prob'))
+        for index in range(len(labels)):
+            writer.writerow((split, int(enroll_ids[index]), int(labels[index]), '%.8f' % probabilities[index]))
+
+
+# Append one row to results.csv (header written when the file is new).
+def append_result(path, row):
+    is_new = not os.path.exists(path)
+    with open(path, 'a', newline='', encoding='utf-8') as output:
+        writer = csv.DictWriter(output, fieldnames=RESULT_COLUMNS)
+        if is_new:
+            writer.writeheader()
+        text_row = {}
+        for name in row:
+            value = row[name]
+            if isinstance(value, float):
+                text_row[name] = '%.6f' % value
+            else:
+                text_row[name] = value
+        writer.writerow(text_row)
+
+
