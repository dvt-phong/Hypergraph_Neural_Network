+# Counts of one log file, per enrollment.
+def count_log(path):
+    counts = []
+    for chunk in pd.read_csv(path, usecols=LOG_COLUMNS, chunksize=CHUNK_ROWS):
+        group = chunk.groupby('enroll_id')
+        part = pd.DataFrame({'all#count': group['action'].count(),          # rows with an action
+                             'session#count': group['session_id'].count()})  # rows with a session id
+        for a in video_action + problem_action + forum_action + click_action + close_action:
+            part[a+'#num'] = (chunk['action'] == a).astype(int).groupby(chunk['enroll_id']).sum()
+        counts.append(part)
+        print(path, sum(len(c) for c in counts), flush=True)
+    if not counts:
+        return pd.DataFrame(columns=count_columns, dtype=int)
+    return pd.concat(counts).groupby(level=0).sum()                         # an enrollment may span chunks
+
