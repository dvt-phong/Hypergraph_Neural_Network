+# Counts of one log file. enroll_ids keeps the order of first appearance, so set(enroll_ids)
+# iterates like the original set(list(log['enroll_id'])).
+def count_log(path):
+    counts, infos, enroll_ids = [], [], []
+    for chunk in pd.read_csv(path, usecols=LOG_COLUMNS, chunksize=CHUNK_ROWS):
+        group = chunk.groupby('enroll_id')
+        part = pd.DataFrame({'all#count': group['action'].count(),          # rows with an action
+                             'session#count': group['session_id'].count()})  # rows with a session id
+        for a in video_action + problem_action + forum_action + click_action + close_action:
+            part[a+'#num'] = (chunk['action'] == a).astype(int).groupby(chunk['enroll_id']).sum()
+        counts.append(part)
+        infos.append(chunk[['username','course_id','enroll_id']].drop_duplicates())
+        enroll_ids.extend(pd.unique(chunk['enroll_id']).tolist())
+        print(path, len(enroll_ids), flush=True)
+    return counts, infos, enroll_ids
+
+
+train_counts, train_infos, train_ids = count_log('prediction_log/train_log.csv')
+test_counts, test_infos, test_ids = count_log('prediction_log/test_log.csv')
+train_enroll = list(set(train_ids))
+test_enroll = list(set(test_ids))
+
+all_num = pd.concat(train_counts + test_counts).groupby(level=0).sum()   # an enrollment may span chunks
