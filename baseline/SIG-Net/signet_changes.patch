+++ b/src/xuetangx_graph_builder.py
@@ -0,0 +1,286 @@
+# XuetangX version of kddcup_graph (graph_builder.py), added for docs/PLAN_BASELINE_v3.md.
+#
+# The original code only has KDD Cup 2015 and NAVER. This file follows kddcup_graph.process step by
+# step on the XuetangX raw data of baseline/prepare_raw.py (log already filtered like the main model:
+# 22 actions, course days 0-34). Translation:
+#   - day         = date(event) − date(course start of course_info.csv)            (KDD: date.csv)
+#   - event       = action group: problem 0, video 1, forum 2, other 3            (KDD: event column)
+#   - 3 windows   = days 0-11, 12-23, 24-35 (12 days each, day 35 is always empty;  (KDD: 3 x 10 days)
+#                   the model shares its layers over the 3 graphs, so they need the same width)
+#   - course feat = distinct objects per event type in the log + enrollments       (KDD: object.csv modules)
+#   - rows without an object (every web_page action and close_forum in XuetangX) are dropped by the
+#     groupby on 'object', as in the original.
+# Changed on purpose (protocol, not translation):
+#   - the per-course z-score of the daily clicks is fitted on the train enrollments of the course
+#     (the original fits it on every enrollment);
+#   - student edges of the third graph are typed by the dropout label (8 dropout / 9 not) only when
+#     the source enrollment is in train; validation/test sources get type 10 ("unknown", the model has
+#     num_rels = 11). The original typed them with the labels of train AND test enrollments. With a
+#     learner split every other enrollment of a learner is in the same split as the learner.
+#   - kept as in the original: feature[day] = click_sum of the LAST (event, object) row of that day in
+#     groupby order (the loop overwrites, it does not add up the day), and the target's own edges are
+#     masked in __getitem__.
+#   - the per-enrollment loops (iterrows, truth_all filters) are rewritten with vectorized pandas;
+#     check_builder.py compares the result with a literal loop translation on a sample.
+
+import os
+import numpy as np
+import pandas as pd
+import torch
+from collections import defaultdict
+from sklearn.preprocessing import StandardScaler
+
+try:
+    import dgl
+    from dgl.data import DGLDataset
+except ImportError:   # building the arrays (check_builder.py) does not need DGL
+    dgl, DGLDataset = None, object
+
+ACTION_EVENT = {}
+for _a in ('problem_get', 'problem_check', 'problem_save', 'reset_problem', 'problem_check_correct', 'problem_check_incorrect'):
+    ACTION_EVENT[_a] = 0                                                             # problem
+for _a in ('seek_video', 'play_video', 'pause_video', 'stop_video', 'load_video'):
+    ACTION_EVENT[_a] = 1                                                             # video
+for _a in ('create_thread', 'create_comment', 'delete_thread', 'delete_comment', 'close_forum'):
+    ACTION_EVENT[_a] = 2                                                             # discussion
+for _a in ('click_info', 'click_courseware', 'click_about', 'click_forum', 'click_progress', 'close_courseware'):
+    ACTION_EVENT[_a] = 3                                                             # other
+WINDOW = 12
+ACTIVITY = [0, 1, 2, 3]
+COURSE_CATE_LIST = ['problem', 'video', 'discussion', 'other']
+
+
+# day = date(event) − date(course start) and event type of every log row.
+def add_days_and_event(log_all, course_info):
+    start = course_info.set_index('course_id')['start'].str[:10]
+    log_all['days'] = (pd.to_datetime(log_all['time'].str[:10]) - pd.to_datetime(log_all['course_id'].map(start))).dt.days
+    log_all['event'] = log_all['action'].map(ACTION_EVENT)
+    return log_all
+
+
+def xuetangx_load(path, chunk_rows=5000000):
+    """Log, truth (with username, course_id) and course start dates of baseline/prepare_raw.py.
+
+    Memory: only rows with an object are kept (every groupby of the original is on 'object', so the
+    other rows never reach the graph; check_builder.py verifies it), with days and event computed per
+    chunk and the time/action strings dropped.
+    """
+    course_info = pd.read_csv(os.path.join(path, 'course_info.csv'), usecols=['course_id', 'start'])
+    parts = []
+    for chunk in pd.read_csv(os.path.join(path, 'prediction_log', 'log.csv'),
+                             usecols=['enroll_id', 'course_id', 'action', 'object', 'time'], chunksize=chunk_rows):
+        chunk = add_days_and_event(chunk[chunk['object'].notna()].copy(), course_info)
+        parts.append(chunk[['enroll_id', 'course_id', 'object', 'days', 'event']])
+    log_all = pd.concat(parts, ignore_index=True)
+    truth_all = pd.read_csv(os.path.join(path, 'prediction_log', 'truth.csv'))
+    enrollments = pd.read_csv(os.path.join(path, 'prediction_log', 'enrollments.csv'))
+    truth_all = truth_all.merge(enrollments, on='enroll_id', how='left')
+    return log_all, truth_all, course_info
+
+
+def build_xuetangx_arrays(log_all, truth_all, course_info, split):
+    """Everything kddcup_graph.process computes, as numpy arrays; split = Series enroll_id -> split."""
+    log_all = log_all.rename(columns={'enroll_id': 'enrollment_id'})
+    truth_all = truth_all.rename(columns={'enroll_id': 'enrollment_id'}).sort_values('enrollment_id').reset_index(drop=True)
+
+    # days and event (xuetangx_load computes them already)
+    if 'days' not in log_all.columns:
+        log_all = add_days_and_event(log_all, course_info)
+
+    # click_sum = rows per (enrollment, event, day, object), the original's count() of 'time';
+    # rows with no object are dropped by groupby
+    all_clicksum = log_all.groupby(['enrollment_id', 'event', 'days', 'object']).size().reset_index(name='click_sum')
+
+    # 3 windows; clicksum = rows per (enrollment, object) inside the window
+    windows = [list(range(w * WINDOW, (w + 1) * WINDOW)) for w in range(3)]
+    activity_log_all = log_all[log_all['event'].isin(ACTIVITY)]
+    interactions = []
+    for days in windows:
+        window_log = activity_log_all[activity_log_all['days'].isin(days)]
+        window_log = pd.merge(window_log, window_log.groupby(['enrollment_id', 'object']).size().reset_index(name='clicksum'), how='left')
+        interactions.append(window_log[['enrollment_id', 'event', 'object', 'clicksum']].groupby(['enrollment_id', 'event', 'object', 'clicksum']).nunique().reset_index())
+
+    # node ids: enrollments, then objects, then courses
+    enroll_list = truth_all['enrollment_id'].tolist()
+    object_list = sorted(activity_log_all['object'].dropna().unique())
+    course_list = sorted(truth_all['course_id'].unique())
+    enroll_node_id = {e: i for i, e in enumerate(enroll_list)}
+    object_node_id = {o: len(enroll_list) + i for i, o in enumerate(object_list)}
+    course_node_id = {c: len(enroll_list) + len(object_list) + i for i, c in enumerate(course_list)}
+    num_node = len(enroll_list) + len(object_list) + len(course_list)
+
+    # enrollment features: feature[day] = click_sum of the last row of that day (as the original loop)
+    last = all_clicksum.groupby(['enrollment_id', 'days'], sort=False)['click_sum'].last().reset_index()
+    enroll_feature = np.zeros((len(enroll_list), 3 * WINDOW))
+    enroll_feature[last['enrollment_id'].map(enroll_node_id).to_numpy(), last['days'].to_numpy()] = last['click_sum'].to_numpy()
+    labels = np.zeros((len(enroll_list), 4))
+    for w in range(3):
+        labels[:, w] = (enroll_feature[:, w * WINDOW:(w + 1) * WINDOW].sum(axis=1) == 0)   # no click in window w
+    labels[:, 3] = truth_all['truth'].to_numpy()                                           # dropout label
+
+    # course features: distinct objects per event type + number of enrollments
+    object_info = activity_log_all[['course_id', 'object', 'event']].dropna().drop_duplicates().sort_values(['course_id', 'object', 'event']).reset_index(drop=True)
+    course_feature = np.zeros((len(course_list), len(COURSE_CATE_LIST) + 1))
+    counts = object_info.groupby(['course_id', 'event']).size()
+    for (course, event), count in counts.items():
+        course_feature[course_node_id[course] - course_node_id[course_list[0]], int(event)] = count
+    enroll_per_course = truth_all.groupby('course_id').size()
+    for course in course_list:
+        course_feature[course_node_id[course] - course_node_id[course_list[0]], -1] = enroll_per_course[course]
+
+    # z-score of the daily clicks per course, fitted on the train enrollments of the course
+    is_train = truth_all['enrollment_id'].map(split).eq('train').to_numpy()
+    node_feature = np.zeros_like(enroll_feature)
+    no_train_courses = 0
+    for course, rows in truth_all.groupby('course_id').indices.items():
+        train_rows = rows[is_train[rows]]
+        if len(train_rows) == 0:                                                     # keep raw counts
+            node_feature[rows] = enroll_feature[rows]
+            no_train_courses += 1
+            continue
+        scaler = StandardScaler().fit(enroll_feature[train_rows])
+        node_feature[rows] = scaler.transform(enroll_feature[rows])
+    course_feature = StandardScaler().fit_transform(course_feature)
+
+    # object-course edges (types 0-3), then enrollment-object edges per window (types 4-7)
+    base_src = object_info['object'].map(object_node_id).to_numpy()
+    base_dst = object_info['course_id'].map(course_node_id).to_numpy()
+    base_etype = object_info['event'].to_numpy().astype(int)
+    o_in_course = defaultdict(list)
+    for o, c in zip(base_src, base_dst):
+        o_in_course[c].append(o)
+    graphs = []
+    for interaction in interactions:
+        src = np.concatenate([base_src, interaction['enrollment_id'].map(enroll_node_id).to_numpy()])
+        dst = np.concatenate([base_dst, interaction['object'].map(object_node_id).to_numpy()])
+        etype = np.concatenate([base_etype, interaction['event'].to_numpy().astype(int) + 4])
+        graphs.append({'src': np.concatenate([src, dst]), 'dst': np.concatenate([dst, src]), 'etype': np.concatenate([etype, etype])})
+
+    # student edges: every ordered pair of enrollments of one learner, typed by the source enrollment
+    truth_all['node'] = truth_all['enrollment_id'].map(enroll_node_id)
+    e_with_student = {}
+    pair_src, pair_dst = [], []
+    for student, group in truth_all.groupby('username', sort=True):
+        nodes = group['node'].to_numpy()
+        e_with_student[student] = nodes.tolist()
+        n = len(nodes)
+        if n < 2:
+            continue
+        i, j = np.where(~np.eye(n, dtype=bool))                                     # row-major, src != dst
+        pair_src.append(nodes[i])
+        pair_dst.append(nodes[j])
+    pair_src = np.concatenate(pair_src)
+    pair_dst = np.concatenate(pair_dst)
+    third_type = np.where(labels[pair_src, 3] == 1, 8, 9)
+    third_type = np.where(is_train[pair_src], third_type, 10)                       # val/test source -> unknown
+    pair_types = [np.where(labels[pair_src, 1] == 1, 8, 9),                          # graph 1: no click in window 2
+                  np.where(labels[pair_src, 2] == 1, 8, 9),                          # graph 2: no click in window 3
+                  third_type]                                                        # graph 3: dropout label
+    student_eid = []
+    for g, graph in enumerate(graphs):
+        offset = len(graph['src'])
+        eid = defaultdict(list)
+        for k, s in enumerate(pair_src):
+            eid[int(s)].append(offset + k)
+        student_eid.append(eid)
+        graph['src'] = np.concatenate([graph['src'], pair_src])
+        graph['dst'] = np.concatenate([graph['dst'], pair_dst])
+        graph['etype'] = np.concatenate([graph['etype'], pair_types[g]])
+
+    # node features: [type one-hot 3 | window clicks 12 | course features 5]
+    zeros_course = np.zeros((len(enroll_list), len(COURSE_CATE_LIST) + 1))
+    obj_rows = np.hstack([np.tile([0, 1, 0], (len(object_list), 1)), np.zeros((len(object_list), WINDOW + len(COURSE_CATE_LIST) + 1))])
+    crs_rows = np.hstack([np.tile([0, 0, 1], (len(course_list), 1)), np.zeros((len(course_list), WINDOW)), course_feature])
+    for w, graph in enumerate(graphs):
+        enr_rows = np.hstack([np.tile([1, 0, 0], (len(enroll_list), 1)), node_feature[:, w * WINDOW:(w + 1) * WINDOW], zeros_course])
+        graph['feature'] = np.vstack([enr_rows, obj_rows, crs_rows])
+    non_feature = np.vstack([np.tile([1, 0, 0], (len(enroll_list), 1)), np.tile([0, 1, 0], (len(object_list), 1)), np.tile([0, 0, 1], (len(course_list), 1))])
+
+    return {
+        'graphs': graphs, 'num_node': num_node, 'non_feature': non_feature, 'labels': labels,
+        'enroll_node_id': enroll_node_id, 'object_node_id': object_node_id, 'course_node_id': course_node_id,
+        'enroll_course': dict(zip(truth_all['enrollment_id'], truth_all['course_id'])),
+        'enroll_student': dict(zip(truth_all['enrollment_id'], truth_all['username'])),
+        'o_in_course': o_in_course, 'e_with_student': e_with_student, 'student_eid': student_eid,
+        'enroll_feature': enroll_feature, 'no_train_courses': no_train_courses,
+    }
+
+
+def get_subgraph(graph, o_with_target, e_with_student, target_course, target_enroll):
+    """Same as graph_builder.get_subgraph."""
+    nodes = torch.unique(torch.cat([o_with_target, e_with_student, target_course, target_enroll], dim=0,))
+    nodes = nodes.type(torch.int64)
+    subgraph = dgl.node_subgraph(graph, nodes, store_ids=True)
+    return subgraph
+
+
+class xuetangx_graph(DGLDataset):
+    def __init__(self, raw_dir, split_path):
+        self.xuetangx_dir = raw_dir
+        self.split_path = split_path
+        super().__init__(name='xuetangx')
+
+    def process(self):
+        log_all, truth_all, course_info = xuetangx_load(self.xuetangx_dir)
+        split = pd.read_csv(self.split_path, index_col='enroll_id')['split']
+        arrays = build_xuetangx_arrays(log_all, truth_all, course_info, split)
+        print('XuetangX graph: %d nodes, courses without train enrollments: %d' % (arrays['num_node'], arrays['no_train_courses']))
+        built = []
+        for graph in arrays['graphs']:
+            g = dgl.graph((torch.tensor(graph['src']), torch.tensor(graph['dst'])), num_nodes=arrays['num_node'])
